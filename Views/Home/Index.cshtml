<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>WebGIS Không Gian Xanh Củ Chi</title>

  <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>

<body>
  <!-- Top-left toggle (giống GEE) -->
  <button id="toggleBtn" class="gee-fab" title="Mở/Đóng panel">
    <i class="fas fa-bars"></i>
  </button>

  <div class="gee-layout">
    <!-- LEFT PANEL (GEE-like) -->
    <aside id="sidebar" class="gee-panel">
      <div class="gee-title">
        <div class="gee-title-main">🌿 WebGIS Không Gian Xanh</div>
        <div class="gee-title-sub">Củ Chi • NDVI 2019–2025</div>
      </div>

      <div class="gee-section">
        <div class="gee-section-h">Bộ lọc</div>

        <label class="gee-label">Chọn năm:</label>
        <select id="yearSelect" class="gee-select"></select>

        <div class="gee-btnrow">
          <button id="btnNdvi" class="gee-btn gee-btn-primary">
            <i class="fa-solid fa-leaf"></i> NDVI
          </button>

          <button id="btnGreenmap" class="gee-btn">
            <i class="fa-solid fa-tree"></i> GreenMap
          </button>
        </div>

        <button id="btnDiff" class="gee-btn gee-btn-warn">
          <i class="fa-solid fa-wave-square"></i> Biến động 2019 → 2025
        </button>
      </div>

      <div class="gee-section">
  <div class="gee-section-h">Ranh giới</div>

  <label class="gee-check">
    <span>Ranh huyện (đỏ)</span>
    <input type="checkbox" id="cbHuyen" checked>
  </label>

  <label class="gee-check">
    <span>Ranh xã (xanh)</span>
    <input type="checkbox" id="cbXa" checked>
  </label>
</div>


      <div class="gee-section">
        <div class="gee-section-h">Thống kê nhanh</div>
        <div class="gee-stats">
          <div class="gee-stat">
            <div class="gee-stat-label">Diện tích xanh</div>
            <div class="gee-stat-value" id="areaValue">-- km²</div>
          </div>
          <div class="gee-stat">
            <div class="gee-stat-label">Tỷ lệ xanh</div>
            <div class="gee-stat-value" id="ratioValue">-- %</div>
          </div>
        </div>
      </div>

      <div class="gee-section">
        <div class="gee-section-h">Đánh giá</div>
        <div class="gee-note">
          <div class="gee-note-icon">📝</div>
          <div class="gee-note-text" id="noteText">Chọn năm để xem đánh giá...</div>
        </div>
      </div>

      <!-- NDVI legend: dạng “thanh gradient đủ màu” giống GEE -->
      <div class="gee-section" id="legendNDVI">
        <div class="gee-section-h">Chú giải NDVI</div>
        <div class="gee-legend">
          <div class="gee-legend-bar ndvi-bar"></div>
          <div class="gee-legend-minmax">
            <span>0</span><span>1</span>
          </div>
        </div>
      </div>

      <!-- Diff legend: bạn có thể để 3 mức (đỏ-vàng-xanh) hoặc 5 mức -->
      <div class="gee-section" id="legendDiff" style="display:none;">
        <div class="gee-section-h">Chú giải biến động</div>
        <div class="gee-legend-list">
          <div class="gee-legend-item"><span class="swatch diff-loss"></span> Giảm (đỏ)</div>
          <div class="gee-legend-item"><span class="swatch diff-stable"></span> Không đổi (vàng)</div>
          <div class="gee-legend-item"><span class="swatch diff-gain"></span> Tăng (xanh)</div>
        </div>
      </div>

      <div class="gee-section">
        <div class="gee-section-h">So sánh 2 năm</div>
        <div class="gee-compare">
          <select id="yearA" class="gee-select"></select>
          <select id="yearB" class="gee-select"></select>
        </div>

        <button id="compareBtn" class="gee-btn">
          <i class="fa-solid fa-layer-group"></i> So sánh
        </button>

        <div id="opacityCompare" class="gee-slider" style="display:none;">
          <div class="gee-label">Kéo để so sánh:</div>
          <input type="range" id="opacitySlider" min="0" max="1" step="0.01" value="0.5">
        </div>
      </div>
    </aside>

    <!-- MAP -->
    <main class="gee-mapwrap">
      <div id="map"></div>
    </main>
  </div>

  <!-- RIGHT CHART PANEL (nút bên phải) -->
  <div id="chartPanel" class="chart-panel chart-collapsed">
    <button id="chartToggle" class="chart-toggle-btn" title="Mở biểu đồ">
      <i class="fas fa-chart-line"></i>
    </button>

    <div class="chart-content">
  <div class="chart-title">📈 Biểu đồ</div>
  <div class="chart-sub">Chọn loại biểu đồ</div>

  <select id="chartMetric" class="gee-select" style="margin-bottom:10px">
    <option value="green_km2">Diện tích xanh (km²)</option>
    <option value="green_ratio">Tỷ lệ xanh (%)</option>
    <option value="ndvi_mean">NDVI trung bình</option>
    <option value="ndvi_minmax">NDVI min/max</option>
    <option value="diff_mean">Biến động NDVI (2019→2025)</option>
  </select>

  <canvas id="chart"></canvas>
</div>
  </div>

  <!-- Loading -->
  <div id="loading" class="loading hidden">
    <div class="spinner"></div>
    <div class="loading-text">Đang tải dữ liệu...</div>
  </div>

  <script src="~/js/app.js" asp-append-version="true"></script>
</body>
</html>
